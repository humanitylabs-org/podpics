[Unit]
Description=PodPics Tailnet App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to match where you cloned the repo.
# This intentionally does not assume Hermes, OpenClaw, or any specific agent workspace.
User=podpics
WorkingDirectory=/opt/podpics
Environment=PODPICS_HOST=127.0.0.1
Environment=PODPICS_PORT=8792
# Optional: choose where PodPics stores inbox/projects/assets/outputs.
# Environment=PODPICS_STORAGE_ROOT=/home/podpics/podpics-workspace
# Optional: legacy Dropbox root for projects imported from older layouts.
# Environment=PODPICS_LEGACY_DROPBOX_ROOT=/path/to/legacy/dropbox
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
